{
  "expo": {
    "name": "Semanggi",
    "slug": "manage-kontrakan",
    "version": "2.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/semanggi-icon.png",
    "scheme": "managekontrakan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sandy.managekontrakan"
    },
    "android": {
      "backgroundColor": "#F7F5F0",
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F0",
        "foregroundImage": "./assets/images/semanggi-icon-foreground.png",
        "monochromeImage": "./assets/images/semanggi-icon-mono.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": true,
      "package": "com.sandy.managekontrakan",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "enforceContrast": true,
          "hidden": false,
          "style": "dark"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5F0",
          "android": {
            "image": "./assets/images/semanggi-icon-foreground.png",
            "imageWidth": 256,
            "imageHeight": 256
          }
        }
      ],
      "expo-sqlite",
      "expo-system-ui",
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikasi memerlukan akses kamera untuk foto bukti piket.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikasi memerlukan akses galeri untuk mengunggah bukti pembayaran dan laporan."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/semanggi-icon-notification.png",
          "androidMode": "default"
        }
      ],
      "./plugins/withAndroidMonochromeVector.js",
      "./plugins/withDynamicColorIcon.js",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "968c2fca-1d0f-4f42-a469-09502a4405b8"
      },
      "expo-navigation-bar": {
        "enforceContrast": true,
        "style": "dark",
        "hidden": false
      }
    },
    "owner": "mustpikeks-2",
    "runtimeVersion": "2.3.0",
    "updates": {
      "url": "https://u.expo.dev/968c2fca-1d0f-4f42-a469-09502a4405b8"
    }
  }
}
