{
  "expo": {
    "name": "Naungi",
    "slug": "manage-kontrakan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/naungi-logo-new.png",
    "scheme": "managekontrakan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F0",
        "foregroundImage": "./assets/images/naungi-icon-foreground-new.png",
        "backgroundImage": "./assets/images/naungi-background-new.png",
        "monochromeImage": "./assets/images/naungi-icon-mono-new.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.sandy.managekontrakan",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EDEAE3",
          "android": {
            "image": "./assets/images/naungi-splash-neww.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikasi memerlukan akses galeri untuk mengunggah bukti pembayaran dan laporan."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon-naungi.png",
          "androidMode": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "968c2fca-1d0f-4f42-a469-09502a4405b8"
      }
    },
    "owner": "mustpikeks-2",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/968c2fca-1d0f-4f42-a469-09502a4405b8"
    }
  }
}
